# Copy this file to .env and fill in the values you need. .env is gitignored —
# it's for LOCAL DEVELOPMENT ONLY. It is never read in production; Vercel and
# Render (or whatever hosts you use) each have their own separate "Environment
# Variables" dashboard for that — see README.md § Deploying.

# ─── Front-end (src/lib/engine.ts) — read by Vite automatically ───
# Where the browser should send API calls. Only needed if you're running the
# front-end against something other than a local `python fmm_server.py`
# (which is the default in dev, no setting required).
# VITE_ENGINE_API_URL=http://127.0.0.1:8000

# ─── Engine server (fmm_server.py) — read at startup ───
# Postgres connection string. Leave unset to use local JSON files under
# .fmm_data/ instead (the default — fine for local dev, nothing to configure).
# It's the full connection string your Postgres provider gives you, not just
# a database name — looks like:
#   postgresql://<user>:<password>@<host>:<port>/<database>
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/fmm_loan_genie

# Port to listen on. Defaults to 8000 locally; hosting platforms usually set
# $PORT for you automatically, so you won't need this outside local testing.
# PORT=8000

# How many months of quote history to keep before auto-deleting. 0 disables
# auto-clearing. Defaults to 3.
# QUOTE_RETENTION_MONTHS=3
